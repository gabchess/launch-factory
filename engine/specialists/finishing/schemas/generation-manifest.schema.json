{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "assets",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "media-generation-manifest/v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "origin",
          "status",
          "source_reference",
          "provider",
          "job_id",
          "provider_receipt",
          "license",
          "media",
          "input_asset_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "imported",
              "catalog",
              "generated",
              "authored",
              "rendered"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "materialized",
              "failed"
            ]
          },
          "source_reference": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "job_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_receipt": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "job_id",
                  "reference"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "job_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reference"
            ],
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "verified",
                  "restricted"
                ]
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "media": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            ]
          },
          "input_asset_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "status",
          "asset_id",
          "sha256",
          "reference"
        ],
        "properties": {
          "kind": {
            "enum": [
              "decode",
              "audio_listening",
              "visual_inspection",
              "human_review"
            ]
          },
          "status": {
            "enum": [
              "not_tested",
              "pass",
              "fail",
              "not_applicable"
            ]
          },
          "asset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
