{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "audio",
    "captions"
  ],
  "properties": {
    "schema_version": {
      "const": "speech-captions/v1"
    },
    "purpose": {
      "const": "speech"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "captions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "startMs",
          "endMs",
          "timestampMs",
          "confidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "endMs": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "timestampMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "pageBreakAfter": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
