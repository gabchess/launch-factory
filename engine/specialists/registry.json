    "linkedin_post": {
      "role": "linkedin_editor",
      "slot": null,
      "channels": [
        "linkedin"
      ],
      "rubric": [
        "source_truth",
        "professional_relevance",
        "specific_insight",
        "selected_voice",
        "no_invented_experience"
      ]
