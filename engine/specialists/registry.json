    "in_app_popup": {
      "role": "popup_designer",
      "slot": 6,
      "channels": [
        "in_app"
      ],
      "capability": "image-render",
      "rubric": [
        "source_truth",
        "context_fit",
        "graphic_copy_match",
        "dismissal",
        "render_inspection"
      ]
    },
    "campaign_plan": {
      "role": "campaign_planner",
      "slot": 7,
      "channels": [
        "calendar"
      ],
      "rubric": [
        "source_truth",
        "weekly_cadence",
        "distinct_angles",
        "timezone",
        "asset_bindings"
