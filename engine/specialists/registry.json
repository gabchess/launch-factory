      "role": "video_lead",
      "slot": 1,
      "channels": [
        "instagram",
        "tiktok"
      ],
      "capability": "video-render",
      "rubric": [
        "source_truth",
        "viewer_relevance",
        "spoken_copy",
        "captions",
        "render_inspection",
        "duration_at_most_30s"
      ]
    },
    "blog": {
      "role": "blog_editor",
      "slot": 2,
      "channels": [
        "blog"
      ],
      "rubric": [
        "source_truth",
        "reader_job",
        "structure",
        "brand_voice",
        "complete_article"
      ]
    },
    "email_segments": {
      "role": "email_editor",
      "slot": 3,
      "channels": [
        "email"
      ],
      "segments": [
        "lead_smb",
        "lead_agency",
        "lead_reseller_affiliate",
        "customer_smb",
        "customer_agency"
      ],
      "rubric": [
        "source_truth",
        "five_distinct_variants",
        "segment_relevance",
        "subject_preheader",
        "cta"
      ]
    },
    "changelog": {
      "role": "changelog_editor",
      "slot": 4,
      "channels": [
        "changelog"
      ],
      "rubric": [
        "source_truth",
        "change_detail",
        "availability_qualifiers",
        "first_action"
